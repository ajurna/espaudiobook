# copy to .env (docker compose reads it from this project directory)
BOOKORBIT_URL=http://app:3000      # BookOrbit inside the shared compose network, or http://192.168.1.10:3000
SIDECAR_PORT=8090
PUID=1000
PGID=1000
TZ=UTC
# Cache cap in bytes; oldest entries are evicted first. 0 = unlimited, then manual rm is the policy.
CACHE_MAX_BYTES=200000000

# No credentials here on purpose: the ESP32 owns its session and sends its Bearer token on every
# request, so the sidecar can only act while the device is asking. nginx (or your proxy) terminates
# TLS in front of it - put it in front even on the LAN, because the token rides in the URL for the
# audio stream. Turn off access logging for /track or accept that tokens land in nginx's log.
